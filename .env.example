# Google Gemini API Key (Get free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (Get from @userinfobot or messaging your bot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Minimum relevance score (1-10) to trigger a Telegram notification (Strict: 8)
MIN_MATCH_SCORE=8

# Maximum job alerts to send per day (0 = unlimited, send all matching >= 8/10)
MAX_JOBS_PER_RUN=0
